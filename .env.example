# =============================================================================
# StudyBuddy Epitech — environment variables
# Copy the relevant blocks:
#   apps/web/.env.local     ← "Web" block
#   apps/worker/.env        ← "Worker" block
#   supabase/.env           ← "Supabase local auth providers" block
# Local values come from `pnpm db:start` (or `pnpm exec supabase status`).
# =============================================================================

# ---------------------------------------------------------------- Web (Next.js)
# Public: inlined in the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase status`>
# Server-only. Not used by the web app at runtime yet; required by the authenticated E2E suite
# to create test users. NEVER expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `supabase status`>

# ---------------------------------------------------------------- Worker
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<same as above>
PORT=8080
# How often expired room reports are purged (ms)
ROOM_PURGE_INTERVAL_MS=600000

# ---------------------------------------------------------------- Supabase local auth providers
# Read by supabase/config.toml through env(). Placeholders are fine if you only run tests.
# Microsoft Entra ID app registration (see README › Microsoft login).
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=<application (client) id>
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=<client secret value>
# Single-tenant URL restricts sign-in to the Epitech directory: https://login.microsoftonline.com/<epitech-tenant-id>
SUPABASE_AUTH_EXTERNAL_AZURE_URL=https://login.microsoftonline.com/<tenant-id>
# GitHub OAuth app (disabled for now; used later to link GitHub to an Epitech account)
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# ---------------------------------------------------------------- E2E (optional)
# Point Playwright at an already-running server instead of starting `next start`.
# E2E_BASE_URL=http://127.0.0.1:3000
# E2E_PORT=3100
# Use a specific Chromium binary (e.g. a preinstalled one) instead of Playwright's download.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
